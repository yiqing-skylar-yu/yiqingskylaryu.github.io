<div class="pub-listing list">
<% for (const item of items) { %>
  <article class="pub-item" <%= metadataAttrs(item) %>>
    <% const name = "Yu, Y. S."; const nameIndex = item.authors.indexOf(name); %>
    <p class="pub-citation"><span class="pub-authors"><% if (nameIndex >= 0) { %><%= item.authors.slice(0, nameIndex) %><strong><%= name %></strong><%= item.authors.slice(nameIndex + name.length) %><% } else { %><%= item.authors %><% } %></span> <% if (item.year) { %><span class="pub-year">(<%= item.year %>).</span><% } %> <span class="pub-title"><%= item.title %></span>. <% if (item.journal) { %><em class="pub-journal"><%= item.journal %></em><% } %><% if (item.volume_issue_pages) { %>, <%= item.volume_issue_pages %><% } %>.<% if (item.doi_or_url) { %> <a class="pub-link" href="<%= item.doi_or_url %>" target="_blank" rel="noopener">Link</a><% } %></p>
  </article>
<% } %>
</div>
