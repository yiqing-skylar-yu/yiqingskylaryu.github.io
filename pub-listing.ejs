<div class="pub-listing list">
<% for (const item of items) { %>
  <article class="pub-item" <%= metadataAttrs(item) %>>
    <p class="pub-citation"><span class="pub-authors"><%- item.authors %></span> <% if (item.year) { %><span class="pub-year">(<%= item.year %>).</span><% } %> <span class="pub-title"><%- item.title %></span>. <% if (item.journal) { %><em class="pub-journal"><%- item.journal %></em><% } %><% if (item.volume_issue_pages) { %>, <%- item.volume_issue_pages %><% } %>.<% if (item.doi_or_url) { %> <a class="pub-link" href="<%= item.doi_or_url %>" target="_blank" rel="noopener">Link</a><% } %></p>
    <% if (item.note) { %>
      <p class="pub-note"><%- item.note %></p>
    <% } %>
  </article>
<% } %>
</div>
